{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoWall",
  "version": "0.1.0",
  "identifier": "com.kalyan.photowall",
  "mainBinaryName": "PhotoWall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoWall",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://thumb.localhost thumb: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kalyan-zitiu",
    "shortDescription": "Waterfall photo wall",
    "longDescription": "Portable desktop viewer that lays a folder of photos out as an equal-width waterfall.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
